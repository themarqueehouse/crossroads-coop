@ Legendary encounters, generated by tools/coop/place_legendaries.py.
@
@ One per map, each with a flag of its own. The flag is set when the Pokemon
@ is beaten or caught and is also the object's hide flag, so it goes away and
@ stays away -- while running from it, or losing to it, leaves it standing
@ exactly where it was.
@
@ Do not edit by hand: re-run the tool.

@ Ran away, or teleported out. Nothing is set, so it is still there.
Legendary_EventScript_Leave::
	releaseall
	end


Legendary_EventScript_Eternatus::
	lockall
	waitse
	playmoncry SPECIES_ETERNATUS, CRY_MODE_ENCOUNTER
	delay 40
	waitmoncry
	setwildbattle SPECIES_ETERNATUS, 65
	setflag FLAG_SYS_CTRL_OBJ_DELETE
	special BattleSetup_StartLegendaryBattle
	waitstate
	clearflag FLAG_SYS_CTRL_OBJ_DELETE
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, Legendary_EventScript_Leave
	goto_if_eq VAR_RESULT, B_OUTCOME_PLAYER_TELEPORTED, Legendary_EventScript_Leave
	setflag FLAG_LEGENDARY_ETERNATUS
	releaseall
	end


